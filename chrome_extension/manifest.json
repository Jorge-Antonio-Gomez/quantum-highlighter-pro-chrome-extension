{
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "version": "2026.0905.2",
    "key": "",
    "oauth2": {
        "client_id": "75539336160-8h8cd5hqmbjmvucgjs76nsp1el9t9jmc.apps.googleusercontent.com",
        "scopes": ["https://www.googleapis.com/auth/drive.appdata"]
    },
    "permissions": [
        "storage",
        "activeTab",
        "identity",
        "alarms",
        "contextMenus",
        "favicon"
    ],
    "host_permissions": [
        "https://www.googleapis.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "libs/floating-ui-core.js",
                "libs/floating-ui-dom.umd.js",
                "libs/tiptap.js",
                "libs/approx-string-match.js",
                "storage-backend.js",
                "anchoring.js",
                "support-link.js",
                "disclosure.js",
                "script.js"
            ],
            "css": [
                "libs/fonts.css",
                "highlights.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "sidebar.html",
                "sidebar.css",
                "sidebar.js",
                "storage-backend.js",
                "disclosure.js",
                "style.css",
                "highlights.css",
                "libs/tiptap.js",
                "libs/fonts.css",
                "libs/fonts/*",
                "images/*",
                "images/toolbar-icons/*",
                "excluded-websites.json",
                "param-whitelist.json"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "action": {
        "default_title": "Show Highlighter Panel"
    },
    "commands": {
      "toggle-sidebar": {
        "suggested_key": {
          "default": "Ctrl+Shift+H",
          "mac": "Command+Shift+H"
        },
        "description": "Abrir/Cerrar la barra lateral de Resaltador Quantum PRO"
      }
    }
}